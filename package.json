{
  "name": "ab-test-calculator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "vitest run",
    "typecheck": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "preview": "astro build && wrangler dev",
    "reference": "python3 scripts/reference/generate.py > src/stats/__fixtures__/reference.json",
    "budget": "node scripts/js-budget.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^6.4.8",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@iconify-json/ph": "^1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unplugin-icons": "^24.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "sharp": false
  }
}
