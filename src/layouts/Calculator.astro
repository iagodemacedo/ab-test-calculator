---
import '../styles/global.css';
import '../styles/app.css';
import { ui } from '../i18n/ui';
import { routes, otherLocale } from '../i18n/routes';
import type { Page } from '../i18n/routes';
import type { Locale } from '../stats/types';
import Sun from '~icons/ph/sun';
import Link from '~icons/ph/link-simple';
interface Props { locale: Locale; page: Page; }
const { locale, page } = Astro.props;
const t = ui[locale];
const other = otherLocale(locale);
const umami = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{t[page]} · AB Test Calculator</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(routes[locale][page], Astro.site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(routes.pt[page], Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(routes.en[page], Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(routes.en[page], Astro.site)} />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    {umami && <script is:inline async src="https://cloud.umami.is/script.js" data-website-id={umami} data-exclude-hash="true" data-exclude-search="true" />}
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={routes[locale].analysis} data-calculator-link>AB Test Calculator</a>
        <nav aria-label={t.navigation}>
          <a href={routes[locale].analysis} data-calculator-link aria-current={page === 'analysis' ? 'page' : undefined}>{t.analysis}</a>
          <a href={routes[locale].pretest} data-calculator-link aria-current={page === 'pretest' ? 'page' : undefined}>{t.pretest}</a>
        </nav>
        <div class="header-actions">
          <a href={routes[other][page]} data-language={other} lang={other}>{other.toUpperCase()}</a>
          <button type="button" class="icon-button" id="theme-toggle" aria-label={t.theme}><Sun aria-hidden="true" /></button>
          {page !== 'about' && <button type="button" class="button secondary share-button" id="share-link"><Link aria-hidden="true" /><span>{t.share}</span></button>}
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer"><a href={routes[locale].about} data-calculator-link>{t.about}</a><p>{t.privacy}</p></footer>
    <script>
      import { track } from '../app/analytics';
      document.querySelectorAll<HTMLAnchorElement>('a[data-calculator-link], a[data-language]').forEach(link => {
        link.addEventListener('click', event => {
          if (document.querySelector('main.calculator') || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          link.hash = location.hash;
          if (link.dataset.language === 'pt' || link.dataset.language === 'en') track('language_switched', { locale: link.dataset.language });
        });
      });
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        track('theme_switched', { theme });
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
        try { if (localStorage.getItem('theme')) return; } catch {}
        document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
      });
    </script>
  </body>
</html>
